PORT=8000
HOST=127.0.0.1

# LLM API Provider & Credentials
# Supported options: openai (default), groq, ollama, or custom openai-compatible API
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Optional custom base URL (e.g. for Ollama or LocalAI: http://localhost:11434/v1)
# OPENAI_BASE_URL=
